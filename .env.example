# Copy this file to .env and fill in real values. Never commit .env.

# ─────────────────────────────────────────────────────────
# docker-compose.yml (local dev) — 컨테이너 MySQL 사용
# ─────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root

# ─────────────────────────────────────────────────────────
# docker-compose.prod.yml (OCI prod) — 호스트 MySQL 사용
#   - DB는 호스트에 직접 설치 (172.17.0.1:3306)
#   - appuser/appuser 비밀번호는 OCI 호스트 /home/ubuntu/secrets/vocaloid-db.env에 보관
# ─────────────────────────────────────────────────────────
APP_DB_USER=appuser
APP_DB_PASSWORD=replace-me-with-strong-password
APP_CORS_ORIGINS=http://your-public-ip-or-domain

# ─────────────────────────────────────────────────────────
# 공통
# ─────────────────────────────────────────────────────────
# JWT signing secret (HS256). MUST be Base64-encoded — JwtTokenProvider runs
# Decoders.BASE64.decode() on this value, so non-Base64 characters (e.g. '-')
# cause `io.jsonwebtoken.io.DecodingException: Illegal base64 character` at boot.
# Generate (>= 256 bits): openssl rand -base64 32
JWT_SECRET=replace-me-with-base64-encoded-256bit-secret
